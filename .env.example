# Copy this file to .env for local development.
# NEVER commit .env to git — add it to .gitignore.

# Generate a real key with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here

# Set to True only during local development
DEBUG=True

# Comma-separated list of allowed hosts
ALLOWED_HOSTS=localhost,127.0.0.1

# Leave blank locally (uses SQLite). On Render, paste the PostgreSQL Internal URL here.
DATABASE_URL=
